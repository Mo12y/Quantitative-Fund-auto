# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# --- 虚拟环境 ---
venv/
.venv/
env/

# --- 数据库 ---
# 只忽略 *.db 是不够的：SQLite 的 WAL/SHM 伴生文件里同样有真实数据
data/*.db
data/*.db-wal
data/*.db-shm
data/_snapshot_*.db
*.db
*.db-wal
*.db-shm

# --- data/ 下的运行时不入库（都能由脚本重跑 / 重新采集）---
# _backup_rows 删行前的真实数据备份
data/backups/
# 采集断点续传进度（本机状态，不入库）
data/collect_progress.json
# 行情缓存（sw_sector_daily.csv 单个就 7MB+）
data/cache/
data/trade_calendar.csv
# 研究模块输出（vol / drawdown / portfolio / factor）
data/*_results/

# --- 运行时缓存 ---
data/sectors_cache.json
# 同类百分位参照系分位表（由 scripts 级脚本重算，85s 可重现；不进版本管理）
data/peer_distributions.json

# --- 真实持仓截图（市值/盈亏/定投明细，直观程度高于 investment_plan.py）---
docs/screenshots/

# --- 报告输出 ---
reports/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- OS ---
.DS_Store
Thumbs.db

# --- 环境变量/密钥 ---
.env
.env.local
*.key
credentials.*

# --- 日志 ---
*.log
logs/

# --- AI 工具本地记忆（不应公开） ---
# 只忽略 .claude 下的私有状态；skills/ 是方法论资产，纳入版本管理（单一副本，避免与 docs 漂移）
.claude/*
!.claude/skills/
.workbuddy/

# --- 第三方文档聚合（非项目内容） ---
docs/llms-full.md

# --- fund profile parse cache (re-collectable in ~9 min via collect_fund_profile.py) ---
data/fund_profile_cache.jsonl

# 个人投资计划（F-01 外置，2026-09-25）—— 个人数据，不进版本库
config/investment_plan.local.yaml
